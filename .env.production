# Production Environment Configuration (AWS RDS)
# Copy this file to .env.production for production deployment
# This configuration uses AWS RDS instead of local MySQL

# APPLICATION ENVIRONMENT
SPRING_PROFILES_ACTIVE=production
JAVA_OPTS="-Xmx1024m -Xms512m"

# SERVICE PORTS
SERVICE_REGISTRY_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8082
USERS_SERVICE_PORT=8083

# EUREKA SERVICE DISCOVERY (Production)
EUREKA_SERVER_URL=http://your-load-balancer:8761/api/v1/service/eureka/
EUREKA_INSTANCE_HOSTNAME=your-production-hostname

# API CONFIGURATION
API_BASE_PATH=/api/v1
API_VERSION=v1

# ------------------------------------------------------------------------------
# 🗄️ AWS RDS DATABASE CONFIGURATION (Production)
# ------------------------------------------------------------------------------
# Single RDS Instance Configuration (Multiple Databases)
# This approach is more cost-effective than separate RDS instances per service
RDS_ENDPOINT=hackathon-main-db.abc123.us-east-1.rds.amazonaws.com
RDS_PORT=3306
RDS_USERNAME=admin
RDS_PASSWORD=your_super_secure_rds_password
RDS_INSTANCE_CLASS=db.t3.small
RDS_ALLOCATED_STORAGE=100
RDS_MULTI_AZ=true
RDS_STORAGE_ENCRYPTED=true

# Database Configuration (Override local settings)
DB_HOST=${RDS_ENDPOINT}
DB_PORT=${RDS_PORT}
DB_USERNAME=${RDS_USERNAME}
DB_PASSWORD=${RDS_PASSWORD}

# Database Names (Multiple databases in single RDS instance)
AUTH_DB_NAME=auth_db
USERS_DB_NAME=users_db

# Production Database URLs (SSL enabled, single RDS instance)
AUTH_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/${AUTH_DB_NAME}?useSSL=true&requireSSL=true&serverTimezone=UTC
USERS_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/${USERS_DB_NAME}?useSSL=true&requireSSL=true&serverTimezone=UTC

# Connection Pool Settings
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5
HIKARI_CONNECTION_TIMEOUT=30000
HIKARI_IDLE_TIMEOUT=600000
HIKARI_MAX_LIFETIME=1800000

# AWS CONFIGURATION (Production)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_production_access_key
AWS_SECRET_ACCESS_KEY=your_production_secret_key

# AWS ECR CONFIGURATION (Production)
ECR_REGISTRY=123456789012.dkr.ecr.us-east-1.amazonaws.com
ECR_REPOSITORY_PREFIX=hackathon-prod

# SECURITY & CORS CONFIGURATION (Production)
# Production Frontend Origins
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com,https://api.yourdomain.com

# HTTP Methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers
CORS_ALLOWED_HEADERS=*,Authorization,Content-Type,X-Requested-With

# Credentials
CORS_ALLOW_CREDENTIALS=true

# JWT AUTHENTICATION (Production)
JWT_SECRET=your_super_long_production_jwt_secret_key_minimum_256_bits
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# DOCKER CONFIGURATION (Production)
COMPOSE_PROJECT_NAME=hackathon-production
DOCKER_BUILDKIT=1

# MONITORING & LOGGING (Production)
LOGGING_LEVEL_ROOT=WARN
LOGGING_LEVEL_COM_HACKATHON=INFO
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# PRODUCTION SETTINGS
# Security settings
SPRING_DEVTOOLS_RESTART_ENABLED=false
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=false

# Debug settings (disabled in production)
DEBUG_MODE=false

# PROJECT INFORMATION
PROJECT_NAME=Hackathon Microservices
PROJECT_VERSION=1.0.0
ENVIRONMENT=production

# EXTERNAL SERVICES (Production)
# Email Service (Production SMTP)
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USERNAME=your_ses_smtp_username
SMTP_PASSWORD=your_ses_smtp_password

# Redis (Production ElastiCache)
REDIS_HOST=your-elasticache-cluster.abc123.cache.amazonaws.com
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_auth_token

# External APIs
EXTERNAL_API_KEY=your_production_api_key
EXTERNAL_API_URL=https://api.production-service.com