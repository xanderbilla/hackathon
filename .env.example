# Spring Boot Microservices Template - Environment Configuration
# Copy this file to .env.hackathon and customize the values for your project
# Usage: cp .env.example .env.hackathon

# APPLICATION ENVIRONMENT
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS="-Xmx512m -Xms256m"

# SERVICE PORTS (Customize if needed)
SERVICE_REGISTRY_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8082
USERS_SERVICE_PORT=8083

# EUREKA SERVICE DISCOVERY
EUREKA_SERVER_URL=http://localhost:8761/api/v1/service/eureka/
EUREKA_INSTANCE_HOSTNAME=localhost

# API CONFIGURATION
API_BASE_PATH=/api/v1
API_VERSION=v1

# MYSQL DATABASE CONFIGURATION (Required for auth and users services)
# Local Development MySQL Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=your_mysql_username
DB_PASSWORD=your_mysql_password

# AWS RDS Configuration (Production)
# Single RDS instance with multiple databases (cost-effective approach)
# Uncomment these for production deployment with RDS
# RDS_ENDPOINT=hackathon-main-db.xyz123.us-east-1.rds.amazonaws.com
# RDS_PORT=3306
# RDS_USERNAME=admin
# RDS_PASSWORD=your_secure_rds_password
# RDS_INSTANCE_CLASS=db.t3.micro
# RDS_MULTI_AZ=false
# RDS_STORAGE_ENCRYPTED=true
# RDS_ALLOCATED_STORAGE=20

# Database Names
AUTH_DB_NAME=auth_db
USERS_DB_NAME=users_db

# Local Development URLs (Default)
AUTH_DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${AUTH_DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
USERS_DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${USERS_DB_NAME}?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# Production RDS URLs (Uncomment for production)
# AUTH_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/${AUTH_DB_NAME}?useSSL=true&requireSSL=true&serverTimezone=UTC
# USERS_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/${USERS_DB_NAME}?useSSL=true&requireSSL=true&serverTimezone=UTC

# Database Connection Pool Settings (Production)
# HIKARI_MAXIMUM_POOL_SIZE=20
# HIKARI_MINIMUM_IDLE=5
# HIKARI_CONNECTION_TIMEOUT=30000
# HIKARI_IDLE_TIMEOUT=600000
# HIKARI_MAX_LIFETIME=1800000

# AWS CONFIGURATION (Optional - for production deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here

# AWS ECR CONFIGURATION (Optional - for Docker registry)
ECR_REGISTRY=public.ecr.aws/your_registry_id
ECR_REPOSITORY_PREFIX=microservice-template

# SECURITY & CORS CONFIGURATION
# Frontend Origins (Add your React/Vue/Angular app URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080,http://localhost:5173

# HTTP Methods
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,PATCH,OPTIONS

# Headers
CORS_ALLOWED_HEADERS=*,Authorization,Content-Type,X-Requested-With

# Credentials
CORS_ALLOW_CREDENTIALS=true

# JWT AUTHENTICATION (Optional - for auth service)
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# DOCKER CONFIGURATION
COMPOSE_PROJECT_NAME=microservices-template
DOCKER_BUILDKIT=1

# MONITORING & LOGGING (Optional)
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_COM_HACKATHON=DEBUG
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus

# DEVELOPMENT CONFIGURATION
# Development mode settings
SPRING_DEVTOOLS_RESTART_ENABLED=true
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=true

# Debug settings
DEBUG_MODE=false
DEBUG_PORT=5005

# HACKATHON SPECIFIC (Customize for your event)
PROJECT_NAME=Sustain-a-thon
PROJECT_VERSION=1.0.0
TEAM_NAME=Shivshakti
HACKATHON_EVENT=Sustain-a-thon

# EXTERNAL SERVICES (Optional - add as needed)
# Email Service
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your_email@gmail.com
# SMTP_PASSWORD=your_email_password

# Redis (Optional - for caching)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=your_redis_password

# External APIs
# EXTERNAL_API_KEY=your_api_key_here
# EXTERNAL_API_URL=https://api.example.com

# ENVIRONMENT SPECIFIC OVERRIDES
# You can override any of the above values by creating environment-specific files:
# - .env.local (for local development)
# - .env.staging (for staging environment)  
# - .env.production (for production environment)