# Spring Microservices Environment Configuration
# Sustain-a-thon Hackathon Project

# Application Environment
SPRING_PROFILES_ACTIVE=local
JAVA_OPTS="-Xmx512m -Xms256m"

# Service Ports
SERVICE_REGISTRY_PORT=8761
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8082
USERS_SERVICE_PORT=8083

# Eureka Configuration
EUREKA_SERVER_URL=http://localhost:8761/eureka/

# API Configuration
API_BASE_PATH=/api/v1

# MySQL Database Configuration
# Local Development (Default)
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=xanderbilla
DB_PASSWORD=0b1001001@

# AWS RDS Configuration (Production)
# Single RDS instance with multiple databases - more cost effective!
# Uncomment and configure for production use
# RDS_ENDPOINT=hackathon-main-db.abc123.us-east-1.rds.amazonaws.com
# RDS_PORT=3306
# RDS_USERNAME=admin
# RDS_PASSWORD=your_secure_rds_password

# Database URLs (automatically switch based on environment)
# Local Development (Default)
AUTH_DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/auth_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
USERS_DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/users_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true

# Production URLs (uncomment for RDS - single instance, multiple databases)
# AUTH_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/auth_db?useSSL=true&requireSSL=true&serverTimezone=UTC
# USERS_DB_URL=jdbc:mysql://${RDS_ENDPOINT}:${RDS_PORT}/users_db?useSSL=true&requireSSL=true&serverTimezone=UTC

# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# ECR Configuration
ECR_REGISTRY=public.ecr.aws/k2g9v6r8
ECR_REPOSITORY_PREFIX=spring-microservice

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:8080
CORS_ALLOWED_METHODS=GET,POST,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=*

# Docker Configuration
COMPOSE_PROJECT_NAME=sustain-a-thon
