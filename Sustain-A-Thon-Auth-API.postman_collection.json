		{
			"name": "Authentication",
			"item": [
				{
					"name": "1️⃣ Register User",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Registration successful\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.be.true;",
									"    pm.expect(jsonData.message).to.include(\"Registration successful\");",
									"});",
									"",
									"pm.test(\"Response contains user data\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('username');",
									"    pm.expect(jsonData.data.username).to.eql('testuser1');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"password123\",\n  \"aadhaarNumber\": \"123456789012\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/register",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"register"
							]
						},
						"description": "Register a new user with valid Aadhaar number from database"
					},
					"response": []
				},
				{
					"name": "2️⃣ Login User (Sets Cookies)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Login successful with cookies\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.be.true;",
									"    pm.expect(jsonData.message).to.include(\"Login successful\");",
									"});",
									"",
									"pm.test(\"Tokens not in response body (security check)\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.accessToken).to.be.null;",
									"    pm.expect(jsonData.data.refreshToken).to.be.null;",
									"});",
									"",
									"pm.test(\"Cookies are set (check headers)\", function () {",
									"    var setCookieHeader = pm.response.headers.get('Set-Cookie');",
									"    if (setCookieHeader) {",
									"        pm.expect(setCookieHeader).to.include('accessToken');",
									"        pm.expect(setCookieHeader).to.include('refreshToken');",
									"        pm.expect(setCookieHeader).to.include('HttpOnly');",
									"    }",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"testuser1\",\n  \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/api/v1/auth/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"api",
								"v1",
								"auth",
								"login"
							]
						},
						"description": "Login user - Sets JWT tokens as HttpOnly cookies (15min access, 1hr refresh)"
					},
					"response": []
				},
				{
					"name": "3️⃣ Get User Profile (/me)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"User profile retrieved successfully\", function () {",
									"    pm.response.to.have.status(200);",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.be.true;",
									"});",
									"",
									"pm.test(\"Profile contains expected data structure\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data).to.have.property('firyInfo');",
									"    pm.expect(jsonData.data).to.have.property('bankDetails');",
									"    pm.expect(jsonData.data.firyInfo).to.have.property('name');",
									"    pm.expect(jsonData.data.bankDetails).to.have.property('accountHolderName');",
									"});",
									"",
									"pm.test(\"Account holder name matches Aadhaar name\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.bankDetails.accountHolderName).to.eql(jsonData.data.firyInfo.name);",
									"});"
								],
								"type": "text/javascript"
							}
						}
